# WordPress (blog content — read only)
NEXT_PUBLIC_WORDPRESS_URL=https://adaptsmedia.info/cmsmedia
WORDPRESS_URL=https://adaptsmedia.info/cmsmedia

# Database — Postgres connection string for the leads CMS.
# Self-hosted on the same server as the app (no external DB dependency —
# see /var/lib/pgsql on the production VPS). For local dev, point this at
# any local or remote Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Admin CMS login (/admin) — one shared username + password, no user accounts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=

# Email notifications for new leads (via SMTP — e.g. Gmail/Workspace with an
# App Password). Leave SMTP_USER/SMTP_PASS unset to disable email and rely
# on the /admin dashboard only — submissions are still saved either way.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sales@adaptsmedia.com
SMTP_PASS=
LEAD_NOTIFICATION_EMAIL=ankita@adaptsmedia.com
