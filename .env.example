# WordPress (blog content — read only)
NEXT_PUBLIC_WORDPRESS_URL=https://adaptsmedia.com
WORDPRESS_URL=https://adaptsmedia.com

# Database — Postgres connection string for the leads CMS.
# Works with any Postgres provider; Neon (https://neon.tech) is a good
# serverless-friendly default for Vercel deployments.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin CMS login (/admin) — one shared username + password, no user accounts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=

# Email notifications for new leads (via Resend: https://resend.com)
# Leave RESEND_API_KEY unset to disable email and rely on the /admin
# dashboard only — submissions are still saved either way.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=sales@adaptsmedia.com
LEAD_NOTIFICATION_FROM=Adapts Media Leads <onboarding@resend.dev>
